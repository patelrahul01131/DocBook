# ---------------------------------------------------------------------------
# DocBook AI Agent (Mistral) configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your key, then make sure these values
# are also available to the Frappe backend process (see site_config.json note
# in the README section of the agent). The frontend NEVER sees this key.
#
# Get a key from https://console.mistral.ai/

MISTRAL_API_KEY=

# Optional: override the model (default: mistral-small-latest)
# Options: mistral-small-latest, mistral-medium-latest, mistral-large-latest
MISTRAL_MODEL=

OPEN_ROUTER_API_KEY=